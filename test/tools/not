#!/usr/bin/env python3
"""Invert a command's exit status, like llvm's `not`.

Real lit suites get this from the LLVM build tree. Shipping it here keeps the
RUN lines identical whether they run under lit or under lit-lite.py.
"""

import subprocess
import sys

if len(sys.argv) < 2:
    print("usage: not <command> [args...]", file=sys.stderr)
    sys.exit(2)

status = subprocess.run(sys.argv[1:]).returncode
sys.exit(0 if status != 0 else 1)
